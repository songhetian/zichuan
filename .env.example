# 资产管理系统 - 环境变量模板
# 用法：复制为 .env 后按需修改（.env 含密钥，不入版本控制）
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# 本项目三套配置，不要混用：
#   .env      —— 生产 / Docker Compose / 宿主机直连真实库的脚本（本模板）
#   .env.dev  —— 日常开发：DB_MODE=local，指向本机 3306 的 asset-manage-dev
#   测试库    —— 由 vitest*.config.ts 内置注入，见各配置文件

# ---------- 数据库连接 ----------

# ① 宿主机直连真实库（本机跑脚本 / prisma migrate deploy / mysqldump 备份时用）
#    3308 = Docker MySQL 容器映射到宿主机的端口，见下方 MYSQL_HOST_PORT
DATABASE_URL="mysql://root:root@localhost:3308/asset-manage"

# ② 容器内应用连库（docker-compose.yml 的 app / db-init 用它覆盖 DATABASE_URL）
#    host 必须是 compose 的【服务名】mysql，端口是【容器内】的 3306，不是宿主机端口
DOCKER_DATABASE_URL="mysql://root:root@mysql:3306/asset-manage"

# ---------- 会话密钥（必填，生产必须替换）----------
# iron-session 的加密密钥，至少 32 字符。⚠️ 不要照抄本模板的值，每套环境生成一个。
# 缺失时 src/lib/auth.ts 会静默回退到代码里写死的默认值 —— 等于任何人可伪造登录态。
# 生成随机值：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---------- 运行环境 ----------
# 生产部署必须是 production（docker-compose.yml 已显式固定，此处兜底）
NODE_ENV=production

# ---------- 端口（可选，右侧为默认值）----------
MYSQL_HOST_PORT=3308       # 真实库容器 → 宿主机端口
MYSQL_DEV_HOST_PORT=3309   # DB_MODE=docker 时开发库容器 → 宿主机端口
NGINX_HOST_PORT=80         # 对外访问端口
