# 资产管理系统 · 生产环境变量
# 用法：复制为 .env 后按注释填写
#   cp .env.example .env
# （.env 含密码密钥，不入版本控制）

# ============================================================
# 【只需填 6 个值】其余保持默认
# ============================================================

# ① 阿里云 RDS 连接信息（分解字段，部署时自动组合 DATABASE_URL）
RDS_HOST="<rds主机地址>"
RDS_PORT=3306
RDS_DATABASE="asset-manage"
RDS_USER="<rds用户名>"
RDS_PASSWORD="<rds密码>"

# ② 会话加密密钥（至少 32 字符，勿用模板值）
#    生成随机串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ③ （可选）docker nginx 对外端口，默认 8080
#    由阿里云宿主机 nginx 反代到 127.0.0.1:8080
NGINX_HOST_PORT=8080

# ============================================================
# 运行环境（部署固定 production，无需改）
# ============================================================
NODE_ENV=production

# ============================================================
# 说明：DATABASE_URL 如何自动组合？
# ============================================================
# · docker-compose 部署：compose 用 RDS_* 字段拼出 DATABASE_URL 注入容器
#   （app、db-init 内 migrate/seed 都用它），无需手写连接串。
# · 宿主机直跑脚本/迁移（如 npx prisma migrate deploy 连 RDS）时，
#   用下面命令临时取组合串（会自动转义密码里的特殊字符）：
#   node -e "const e=s=>encodeURIComponent(s);console.log('mysql://'+e(process.env.RDS_USER)+':'+e(process.env.RDS_PASSWORD)+'@'+process.env.RDS_HOST+':'+(process.env.RDS_PORT||3306)+'/'+(process.env.RDS_DATABASE||'asset-manage'))"
# · 应用代码里 prisma.ts 也会在缺 DATABASE_URL 时用 RDS_* 兜底组合，本机 next dev 连 RDS 也可直接跑。
# · 本项目暂不接入 OSS，当前没有图片/文件上传功能，无需 OSS 配置。

# ── 沿用旧字段？──
# 旧的 DATABASE_URL / DOCKER_DATABASE_URL 已废弃：一个库一个地址时冗余。
# 若你本地开发仍想直接写连接串，可在 .env.dev 里保留 DATABASE_URL（互不影响）。