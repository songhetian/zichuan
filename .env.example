# 资产管理系统 - Docker 环境变量
# 复制自模板；请按需修改，SESSION_SECRET 切勿提交到版本库

# 本地开发数据库连接（宿主机通过 127.0.0.1 访问）
DATABASE_URL="mysql://root:root@localhost:3308/asset-manage"

# Docker 内部数据库连接（容器间通过服务名 mysql 访问）
DOCKER_DATABASE_URL="mysql://root:root@mysql:3306/asset-manage"

# iron-session 加密密钥（≥32 字符，已随机生成，请妥善保管并更换）
SESSION_SECRET="d9f43975c7533dc065590ed359cd5d89d6758681d28aebc9dc5567e1caae44d2"

# 运行环境
NODE_ENV="production"

# MySQL 宿主机端口（默认 3308）
MYSQL_HOST_PORT=3308

# Nginx 宿主机端口（默认 80）
NGINX_HOST_PORT=80
