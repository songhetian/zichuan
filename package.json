{
  "name": "zichuan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "资产管理系统 - 企业资产管理解决方案",
  "scripts-doc": {
    "install": "【安装后自动执行】生成 Prisma 客户端",
    "dev": "【★日常开发】一键启动：释放端口 → 检查/建开发库 → 迁移 → Prisma Client → 种子 → 启动前端。用隔离开发库（本机 MySQL 的 asset-manage-dev），不碰真实数据",
    "build": "【生产构建】生成 Prisma 客户端 + Next.js 生产构建",
    "start": "【本地生产】启动生产服务（⚠️ 读 .env，连的是真实库；需先 npm run build）",
    "test": "【测试】全量测试（组件 + 服务端/DB），指向隔离测试库 asset-manage-test",
    "test:ui": "【测试】仅 UI 组件测试（jsdom，不连库，最快）",
    "db": "【开发库/测试库】子命令：status（默认）| up | migrate | reset | test:init | logs | down；只操作隔离库",
    "free-port": "【工具】释放端口：npm run free-port 3001（默认 3000，只终止占用该端口的进程）",
    "docker": "【生产容器】子命令：deploy | update | mysql | down | restart | logs | ps | migrate | seed | reset"
  },
  "scripts": {
    "install": "node scripts/prisma-generate.js",
    "dev": "node scripts/dev-start.js",
    "build": "prisma generate && next build",
    "start": "node scripts/prod-start.js",
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.frontend.config.ts",
    "db": "node scripts/dev-db.js",
    "free-port": "node scripts/free-port.js",
    "docker": "node scripts/docker.js",
    "audit:workflow": "node scripts/audit-workflow-final-role.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
