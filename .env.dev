# ============================================================
# 开发环境专用配置（本地 MySQL / 隔离库）
# ------------------------------------------------------------
# 由 scripts/dev-start.js（一键起环境）与 scripts/dev-next.js（npm run dev）
# 加载，会【覆盖】.env 中的同名变量。
# 这里指向的是独立的开发库，绝不指向真实库 asset-manage。
#
# 隔离方式：
#   - 数据库来源 本机已装的 MySQL（DB_MODE=local，脚本不会启动 Docker）
#   - 独立库名   asset-manage-dev（真实库是 asset-manage）
#   - 端口       3306（真实库在 Docker 3308，两者互不相干）
#
# 随便 migrate / seed / 清库，都不会影响真实数据。
# 想改回「脚本自动拉起 Docker 容器」：把 DB_MODE 改成 docker。
# ============================================================

DB_MODE=local
DATABASE_URL="mysql://root:root@localhost:3306/asset-manage-dev"
