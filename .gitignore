node_modules/
.DS_Store
.next/
out/
tsconfig.tsbuildinfo
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.prisma/

# 本地 AI 助手产物（工作记忆、技能包、安装清单）
.workbuddy/*
.agent/*
.agents/
skills-lock.json

# Python 缓存
__pycache__/
*.pyc

# Python 打包产物（PyInstaller：build/ 中间件 + dist/ 可执行文件）
scripts/build/
scripts/dist/*
# ⚠️ 这行必须带 * 号，且要用 ! 把里面的测试夹具捞回来（见文末说明）
!scripts/dist/asset_import.xlsx

# 临时/草稿文件（下划线开头）
scripts/_*
tests/_*

# 真机取证临时物（CDP 截图、浏览器配置、会话 cookie 等）
.tmp-*

# 工具产物
vitest.config.ts.timestamp-*.mjs

# 根目录的 Excel 样例/临时文件（导入样例、格式测试等，非测试夹具）
/*.xlsx
/*.xls
/query
/功能.txt

# ============================================================
# ⚠️ 严禁整目录忽略 scripts/ 或 tests/。
# 它们是项目源码：package.json 的 scripts 与 vitest 配置都依赖其中的文件。
# 历史上两条宽忽略导致 10 个脚本 + 21 个测试（含 db-guard.ts）静默未跟踪，
# 换机器或 clone 后直接报 "Cannot find module '.../scripts/xxx.js'"。
#
# ⚠️ 同理，scripts/ 下的这几个 Excel 是**测试夹具**，被 3 个测试文件直接读取，不可忽略：
#   scripts/asset_import.xlsx                   scripts/田鹤松_硬件信息.xlsx
#   scripts/测试导入_多行数据.xlsx               scripts/测试导入_6人3部门.xlsx
#   scripts/测试导入_多内存多硬盘.xlsx           scripts/dist/asset_import.xlsx
# 引用者：tests/script-excel-import.test.ts  tests/hardware-scanner-excel.test.ts
#         tests/auto-import.test.ts
# ============================================================
